{
  "name": "agentmesh",
  "private": true,
  "description": "Local-first mesh that lets Claude Code sessions on different machines work together like an engineering team.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./apps/*\" --filter \"./plugins/*\" run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check:size": "node scripts/check-file-size.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm check:size && pnpm test",
    "dev:hub": "pnpm --filter @agentmesh/hub dev",
    "dev:bridge": "pnpm --filter @agentmesh/discord-bridge dev",
    "mesh": "pnpm --filter @agentmesh/cli start"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "fast-uri": "^3.1.9",
      "body-parser": "^2.4.0"
    }
  }
}
