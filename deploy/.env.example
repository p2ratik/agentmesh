# Copy to deploy/.env on the hub VM (never commit the real file).

# --- referenced from mesh.yaml (names are up to you; these match config/examples) ---
# Generate long random values, e.g. `openssl rand -hex 24`.
HERMES_INGEST_TOKEN=
GITHUB_WEBHOOK_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_APP_ID=
DISCORD_GUILD_ID=

# --- docker compose ---
# Only on a server set up before the rename to Cosmicwave (0.8.0), whose data is in the volumes
# agentmesh_*: set this before the first `git pull` of 0.8.0 or later, and keep it
# (docs/deploy.md#a-deploy-by-hand). Without it, compose uses the project cosmicwave, on new volumes.
# COMPOSE_PROJECT_NAME=agentmesh
# Where the mesh config directory lives on the VM (mounted read-only at /config).
COSMICWAVE_CONFIG_DIR=../config
# Tailscale: bind NATS and the ingest endpoint to the VM's tailnet IP.
# Public TLS endpoint: NATS_BIND=0.0.0.0 and NATS_PUBLIC_HOST=<the certificate's DNS name>
# (render nats.conf with `cmw nats-config --tls`).
NATS_BIND=127.0.0.1
NATS_PUBLIC_HOST=
HUB_HTTP_BIND=127.0.0.1
# Container caps, sized for a 1–2 GB VM (docs/deploy.md#hardening-the-server). Memory in
# Docker units (256m, 1g); PIDS_LIMIT counts processes and threads in each container.
NATS_MEM_LIMIT=256m
HUB_MEM_LIMIT=512m
BRIDGE_MEM_LIMIT=384m
PIDS_LIMIT=256

# --- every Cosmicwave process (set by compose for the containers) ---
# COSMICWAVE_CONFIG=/config            config directory (hub, bridge)
# COSMICWAVE_DATA_DIR=/data            hub.sqlite location (hub)
# COSMICWAVE_NATS_URL=nats://nats:4222 overrides nats.servers (comma-separated)
# COSMICWAVE_NKEY_SEED=/secrets/x.nk   seed or path to a seed file
# COSMICWAVE_SECRETS_DIR=/secrets      hub, auth-callout mode: the issuer, xkey and sys seeds
# COSMICWAVE_NATS_USER= / COSMICWAVE_NATS_PASS= / COSMICWAVE_NATS_TOKEN=   alternatives to nkeys
COSMICWAVE_LOG_LEVEL=info

# --- plugin (each developer's laptop; normally set via the plugin options) ---
# COSMICWAVE_AGENT_ID, COSMICWAVE_NATS_URL, COSMICWAVE_NKEY_SEED, COSMICWAVE_PREFIX,
# COSMICWAVE_HEARTBEAT_SECONDS (20), COSMICWAVE_LOG_FILE
