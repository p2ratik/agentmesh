# Copy to deploy/.env on the hub VM (never commit the real file).

# --- referenced from mesh.yaml (names are up to you; these match config/examples) ---
# Generate long random values, e.g. `openssl rand -hex 24`.
HERMES_INGEST_TOKEN=
GITHUB_WEBHOOK_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_APP_ID=
DISCORD_GUILD_ID=

# --- docker compose ---
# Where the mesh config directory lives on the VM (mounted read-only at /config).
AGENTMESH_CONFIG_DIR=../config
# Tailscale: bind NATS and the ingest endpoint to the VM's tailnet IP.
# Public TLS endpoint: NATS_BIND=0.0.0.0 and NATS_PUBLIC_HOST=<the certificate's DNS name>
# (render nats.conf with `agentmesh nats-config --tls`).
NATS_BIND=127.0.0.1
NATS_PUBLIC_HOST=
HUB_HTTP_BIND=127.0.0.1

# --- every AgentMesh process (set by compose for the containers) ---
# AGENTMESH_CONFIG=/config            config directory (hub, bridge)
# AGENTMESH_DATA_DIR=/data            hub.sqlite location (hub)
# AGENTMESH_NATS_URL=nats://nats:4222 overrides nats.servers (comma-separated)
# AGENTMESH_NKEY_SEED=/secrets/x.nk   seed or path to a seed file
# AGENTMESH_NATS_USER= / AGENTMESH_NATS_PASS= / AGENTMESH_NATS_TOKEN=   alternatives to nkeys
AGENTMESH_LOG_LEVEL=info

# --- plugin (each developer's laptop; normally set via the plugin options) ---
# AGENTMESH_AGENT_ID, AGENTMESH_NATS_URL, AGENTMESH_NKEY_SEED, AGENTMESH_PREFIX,
# AGENTMESH_HEARTBEAT_SECONDS (20), AGENTMESH_LOG_FILE
