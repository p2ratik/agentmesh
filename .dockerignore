# The image builds only the hub and the bridge; none of this belongs in the build context.
.git
**/node_modules
deploy/.env*
deploy/secrets
deploy/nats/nats.conf
# The NATS Let's Encrypt private key on a hand-built VM.
deploy/nats/tls
config/
**/*.nk
**/*.creds
**/.env
**/.env.*
# The hub's state from a local run.
data/
